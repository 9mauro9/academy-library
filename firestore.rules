rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // CMS admin — only the designated operator account may write
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == '9mauro9@gmail.com';
    }

    // -----------------------------------------------------------------------
    // PUBLIC CATALOG — world-readable, admin-only writes
    // -----------------------------------------------------------------------
    match /assets/{assetId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /curriculum_map/{mapId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /document_chunks/{chunkId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /parent_sections/{sectionId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // SYSTEM / CMS AUDIT COLLECTIONS — authenticated read, admin-only write
    // -----------------------------------------------------------------------
    match /cms_history/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /cache_invalidations/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /external_progress/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /metadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // MULTI-TENANT USER DATA — strict UID isolation
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /user_notes/{noteId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    match /timelines/{timelineId} {
      allow read, write: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // -----------------------------------------------------------------------
    // Default deny — OS 2.2 Pillar 4 (Least Privilege)
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
