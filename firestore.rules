rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions (OS 2.2 Centralized Authentication & RBAC)
    // -----------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        ('email' in request.auth.token && request.auth.token.email == '9mauro9@gmail.com')
      );
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return isSelf(userId);
    }

    // CMS admin — designated super_admin or operator email
    function isAdmin() {
      return isSuperAdmin();
    }

    // -----------------------------------------------------------------------
    // CENTRALIZED USER REGISTRY & IMMUTABLE AUDIT LEDGER (OS 2.2)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSuperAdmin() || isSelf(userId);
      allow write: if isSuperAdmin();
      allow create: if isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isSelf(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      match /{subcollection}/{docId} {
        allow read, write: if isSuperAdmin() || isSelf(userId);
      }
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated(); // Log entries can be appended by authenticated sessions
      allow update, delete: if false;     // Strictly immutable
    }

    // -----------------------------------------------------------------------
    // PUBLIC CATALOG — world-readable, admin-only writes
    // -----------------------------------------------------------------------
    match /assets/{assetId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /curriculum_map/{mapId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /document_chunks/{chunkId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /parent_sections/{sectionId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // SYSTEM / CMS AUDIT COLLECTIONS — authenticated read, admin-only write
    // -----------------------------------------------------------------------
    match /cms_history/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /cache_invalidations/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /external_progress/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /metadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // USER DATA COLLECTIONS
    // -----------------------------------------------------------------------
    match /user_notes/{noteId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    match /timelines/{timelineId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    match /agent_messages/{messageId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    match /pcap_sessions/{sessionId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isSuperAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    // -----------------------------------------------------------------------
    // Default deny — OS 2.2 Pillar 4 (Least Privilege)
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
