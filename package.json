{
  "name": "academy-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "NODE_PATH=./node_modules node api/server.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "extract": "python3 etl/extract.py",
    "load": "NODE_PATH=./node_modules node etl/load.cjs",
    "ingest": "npm run extract && npm run load",
    "sync-sheets": "NODE_PATH=./node_modules node etl/sync_sheets.cjs",
    "api": "NODE_PATH=./node_modules node api/server.cjs",
    "simulator": "NODE_PATH=./node_modules node etl/simulate_triggers.cjs",
    "verify": "NODE_PATH=./node_modules node test/verify.cjs",
    "verify-frontend": "NODE_PATH=./node_modules node test/verify_frontend_api.cjs",
    "verify-versioning": "NODE_PATH=./node_modules node test/verify_versioning.cjs",
    "verify-taxonomy": "NODE_PATH=./node_modules node test/verify_taxonomy.cjs",
    "sync-docs": "NODE_PATH=./node_modules node scripts/sync-docs.cjs",
    "test:rules": "jest test/firestore.rules.test.cjs --forceExit --detectOpenHandles",
    "test": "npm run test:rules",
    "generate-architecture-diagrams": "node scripts/sync-docs.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "jest": "29.7.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "transform": {}
  }
}
